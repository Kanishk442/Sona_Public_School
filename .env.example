MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sona
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=principal@example.com
ADMIN_PASSWORD=ChangeMe@123
PORT=3000

# Free email alerts + password reset (Brevo free plan, works on Render free). Optional.
BREVO_API_KEY=
MAIL_FROM=            # sender email you verified in Brevo
NOTIFY_EMAIL=         # where enquiry alerts go (defaults to ADMIN_EMAIL)
BASE_URL=             # e.g. https://your-app.onrender.com (for reset links; optional)
